# BU-no-strip (Base Universal, No Strip) Fragment
# Variant of bu.fragment for flavours that install strip-sensitive packages
# (OpenJDK, .NET SDK, etc.) via apt. Omits strip --strip-unneeded and
# *.a deletion which corrupt dpkg-managed binaries and dpkg tools.
#
# Flavours using this variant: java
# CI check: scripts/check-bu-consistency.sh

# BU-NO-STRIP-START
FROM ubuntu:24.04@sha256:786a8b558f7be160c6c8c4a54f9a57274f3b4fb1491cf65146521ae77ff1dc54 AS base

ARG SNAPSHOT_DATE=""

FROM base AS bu-base
RUN if [ -n "$SNAPSHOT_DATE" ]; then \
      sed -i "s|http://archive.ubuntu.com/ubuntu|https://snapshot.ubuntu.com/ubuntu/${SNAPSHOT_DATE}T000000Z|g" /etc/apt/sources.list \
      && sed -i "s|http://security.ubuntu.com/ubuntu|https://snapshot.ubuntu.com/ubuntu/${SNAPSHOT_DATE}T000000Z|g" /etc/apt/sources.list; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      git=1:2.43.0-1ubuntu7.3 \
      git-lfs=3.4.1-1ubuntu0.4 \
      openssh-client=1:9.6p1-3ubuntu13.16 \
      make=4.3-4.1build2 \
      build-essential \
      jq=1.7.1-3ubuntu0.24.04.2 \
      yq=3.1.0-3 \
      curl=8.5.0-2ubuntu10.9 \
      wget=1.21.4-1ubuntu4.1 \
      zip=3.0-13ubuntu0.2 \
      unzip=6.0-28ubuntu4.1 \
      zstd=1.5.5+dfsg2-2build1.1 \
      tar=1.35+dfsg-3build1 \
      gzip=1.12-1ubuntu3.1 \
      ca-certificates=20240203 \
      openssl=3.0.13-0ubuntu3.9 \
      diffutils=1:3.10-1build1 \
      patch=2.7.6-7build3 \
      file=1:5.45-3build1 \
      tree=2.1.1-2ubuntu3.24.04.2 \
 && rm -rf /var/lib/apt/lists/* \
 && rm -rf /usr/share/man/* /usr/share/doc/* /usr/share/info/* \
 # NOTE: strip and *.a deletion omitted — breaks dpkg-managed binaries
 # and dpkg tools (ldconfig, dpkg-deb) during subsequent apt installs.
 && find / -perm /6000 -type f -exec chmod a-s {} + 2>/dev/null || true \
 && find / -perm -002 -type f -exec chmod o-w {} + 2>/dev/null || true
# BU-NO-STRIP-END

# Renovate configuration for automated dependency updates
# Spec reference: S9.3 Update Mechanism, P6 Maintainable
#
# What Renovate auto-updates:
#   - Base image digest (ubuntu:24.04@sha256:...)
#   - GitHub Actions versions (actions/checkout, docker/login-action, etc.)
#   - Node.js version (via Dockerfile ARG in node/pnpm/heavy flavours)
#   - Go version (via Dockerfile ARG in go flavour)
#   - Bun version (via Dockerfile ARG in bun flavour)
#
# What requires manual updates:
#   - docker-ce-cli version (pinned in Dockerfile, no apt datasource)
#   - Node.js tarball SHA256 (must be manually verified per version, both amd64 and arm64)
#   - Go tarball SHA256 (must be manually verified per version, both amd64 and arm64)
#   - Bun tarball SHA256 (must be manually verified per version, both amd64 and arm64)
#   - Rust version (via rustup, no direct tarball datasource)
#   - Flutter version (no standard datasource for tarball releases)
#   - Nix version (installed via official installer)
#   - apt package versions (pinned in Dockerfile, Ubuntu repo only)

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["every weekend"],
  "customManagers": [
    {
      "description": "Track NODE_VERSION ARG in Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/(node|pnpm|heavy)\\/Dockerfile$/"],
      "matchStrings": [
        "ARG NODE_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "description": "Track GO_VERSION ARG in Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/go\\/Dockerfile$/"],
      "matchStrings": [
        "ARG GO_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "loose"
    },
    {
      "description": "Track BUN_VERSION ARG in Dockerfile",
      "customType": "regex",
      "managerFilePatterns": ["/^images\\/bun\\/Dockerfile$/"],
      "matchStrings": [
        "ARG BUN_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "bun",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Base image digest updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "enabled": true,
      "semanticCommitType": "feat",
      "labels": ["base-image", "automated"]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci"
    },
    {
      "description": "Node.js version updates (from Dockerfile ARG)",
      "matchDatasources": ["node-version"],
      "matchDepNames": ["node"],
      "enabled": true,
      "semanticCommitType": "feat",
      "labels": ["nodejs", "automated"],
      "commitMessageSuffix": " (also update NODE_SHA256 for amd64+arm64 manually)"
    },
    {
      "description": "Go version updates (from Dockerfile ARG)",
      "matchDatasources": ["golang-version"],
      "matchDepNames": ["go"],
      "enabled": true,
      "semanticCommitType": "feat",
      "labels": ["golang", "automated"],
      "commitMessageSuffix": " (also update GO_SHA256 for amd64+arm64 manually)"
    },
    {
      "description": "Bun version updates (from Dockerfile ARG)",
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["bun"],
      "enabled": true,
      "semanticCommitType": "feat",
      "labels": ["bun", "automated"],
      "commitMessageSuffix": " (also update BUN_SHA256 for amd64+arm64 manually)"
    },
    {
      "description": "Node.js in pnpm flavour",
      "matchDatasources": ["node-version"],
      "matchFileNames": ["images/pnpm/Dockerfile"],
      "matchDepNames": ["node"],
      "enabled": true,
      "semanticCommitType": "feat",
      "labels": ["nodejs", "pnpm", "automated"],
      "commitMessageSuffix": " (also update NODE_SHA256 for amd64+arm64 manually)"
    }
  ],
  "docker": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on Monday"]
  },
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies", "automated"],
  "reviewers": ["WyattAu"]
}
